{
  "id": "message-stamp-suffix",
  "name": "Message Stamp Suffix",
  "description": "Converts a structured responsePrefix marker into a compact model/provider suffix.",
  "version": "1.0.0",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "marker": { "type": "string" },
      "separator": { "type": "string" },
      "identityMode": { "type": "string", "enum": ["initial", "full"] },
      "providerFallbackLength": { "type": "integer", "minimum": 1, "maximum": 12 },
      "modelFallbackLength": { "type": "integer", "minimum": 1, "maximum": 24 },
      "providerAliases": { "type": "object", "additionalProperties": { "type": "string" } },
      "modelAliases": { "type": "object", "additionalProperties": { "type": "string" } }
    }
  }
}
